# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real values.
# If the site is deployed on Vercel, `npx vercel env pull .env.local` fetches them.

# --- Spotify now playing (lib/spotify.ts) ---
# https://developer.spotify.com/dashboard
# Refresh token needs the user-read-currently-playing scope.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Mailgun contact form (pages/api/email.ts) ---
# Mailgun dashboard > API keys / Sending domains
MAILGUN_API_KEY=
DOMAIN=mg.example.com
